# LinkedIn member access token with scopes: openid profile email w_member_social
LINKEDIN_ACCESS_TOKEN=

# Shared secret MCP clients send as "Authorization: Bearer <key>" (min 16 chars)
MCP_API_KEY=

# Optional
# BIND_ADDR=127.0.0.1:8080
# ALLOWED_HOSTS=mcp.example.com          # extra Host header values when deployed behind a domain
# RUST_LOG=info,linkedin_mcp=debug
